#!/usr/bin/env bash
# nvim wrapper with auto-restart on config update.
#
# <leader>xu updates the config (git pull) then quits nvim with exit
# code 42 (":cq 42"); this wrapper detects 42 and relaunches nvim with
# the freshly pulled config. Any other exit code passes through.
#
# Install (so it shadows /usr/bin/nvim in your PATH):
#   cp ~/.config/nvim/scripts/nvim ~/.local/bin/nvim
#   chmod +x ~/.local/bin/nvim
#   (make sure ~/.local/bin comes before /usr/bin in $PATH)
#
# The real nvim must be called by absolute path to avoid recursion:
NVIM_BIN="$(command -v nvim 2>/dev/null || true)"
# resolve to a path that is NOT our own script
if [ -z "$NVIM_BIN" ] || [ "$(readlink -f "$NVIM_BIN")" = "$(readlink -f "$0")" ]; then
  for c in /usr/bin/nvim /usr/local/bin/nvim; do
    [ -x "$c" ] && NVIM_BIN="$c" && break
  done
fi
if [ -z "$NVIM_BIN" ] || [ ! -x "$NVIM_BIN" ]; then
  echo "nvim wrapper: cannot find the real nvim binary" >&2
  exit 127
fi

while true; do
  "$NVIM_BIN" -- "$@"
  rc=$?
  if [ "$rc" -eq 42 ]; then
    # config updated via <leader>xu — relaunch with the new config
    echo "[nvim] config updated, restarting..." >&2
    sleep 0.5
    continue
  fi
  exit "$rc"
done
